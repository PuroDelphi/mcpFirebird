# MCP Firebird Environment Variables
# Copy this file to .env in your project root and customize the values

# === Transport Configuration (Prioritized) ===
# Options: http (recommended), sse, stdio, unified
TRANSPORT_TYPE=http
# Port for the HTTP Streamable transport (default 3003)
HTTP_PORT=3003
# HTTP/SSE/unified bind only to loopback by default.
HTTP_HOST=127.0.0.1
# To listen remotely (including Docker), set HTTP_HOST=0.0.0.0 and explicitly
# enable remote exposure. Use authentication and terminate TLS at your proxy.
MCP_ALLOW_REMOTE=false
# Exact accepted HTTP Host names/IPs, without ports. Bracket IPv6 addresses.
# Defaults on loopback: localhost,127.0.0.1,[::1]. Required for remote binding.
# MCP_ALLOWED_HOSTS=mcp.example.com

# === HTTP Streamable Mode Settings ===
# Default: stateless (true) - recommended for modern setups
# Set to false for stateful mode (requires session management)
STREAMABLE_STATELESS_MODE=true
# Session timeout for stateful mode (milliseconds)
STREAMABLE_SESSION_TIMEOUT_MS=1800000

# === Database Connection ===
FIREBIRD_HOST=localhost
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=/path/to/your/database.fdb
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=masterkey
FIREBIRD_ROLE=

# === Security & Authorization (EMA) ===
# Token required for client connections when using Enterprise Managed Authorization
FIREBIRD_API_KEY=
# Additional exact browser origins. Empty = same-origin only; * is rejected.
# Origin and Host validation apply to all HTTP routes, including preflights.
# For TLS termination, explicitly list the public HTTPS origin if browsers use it.
# Example: MCP_ALLOWED_ORIGIN=https://mcp.example.com,https://app.example.com
MCP_ALLOWED_ORIGIN=
# Raw INSERT/UPDATE/DELETE/DDL through query tools is disabled by default.
# Set to true only for trusted deployments that require write access.
# Explicit allowedOperations/forbiddenOperations and sql.allowDDL=false are enforced.
# Without an explicit policy, true retains historical write/DDL behavior.
ALLOW_RAW_SQL=false
# If using token auth, specify the real database password here
# FIREBIRD_REAL_PASSWORD=masterkey
# Path to a JSON or CommonJS security configuration file (optional).
# Precedence: --security-config > FIREBIRD_SECURITY_CONFIG > SECURITY_CONFIG > SECURITY_CONFIG_PATH > FIREBIRD_SECURITY_JSON
FIREBIRD_SECURITY_CONFIG=
# Legacy alias retained for compatibility:
SECURITY_CONFIG_PATH=
# Optional inline alternative (64 KiB UTF-8 maximum). Do not set file paths when using this.
# Invalid or empty inline JSON prevents startup; leave UNSET to use defaults.
# alpha.2: invalid selected files also prevent startup. No silent policy fallback.
# FIREBIRD_SECURITY_JSON='{"security":{"allowedTables":["EMPLOYEES"],"allowedOperations":["SELECT"]}}'
# SQL settings may be included at the root (or inside security, but not both):
# FIREBIRD_SECURITY_JSON='{"security":{"allowedOperations":["SELECT"]},"sql":{"allowedSystemTables":["RDB$PROCEDURES"],"allowDDL":false}}'
# alpha.3: advanced controls are opt-in; no implicit row/size/deadline/rate/count caps.
# Catalog reads and procedures keep historical support when no restrictions are selected.
# Example: enable only a row cap (no other limits or SQL restrictions):
# FIREBIRD_SECURITY_JSON='{"security":{"maxRows":1000}}'
# Remove a control's property and restart to disable it. See docs/security.md.
# OAuth2 configurations additionally require resourceUrl (canonical public MCP
# URL) and authorizationServers (HTTPS issuer URLs). Introspection must return
# aud containing the exact resourceUrl. See docs/security.md for migration.

# === Wire Encryption (Firebird 3.0+) ===
# Requires node-firebird-driver-native
# Options: Disabled, Enabled, Required
FIREBIRD_WIRECRYPT=Disabled
# Use native driver (supports wire encryption)
USE_NATIVE_DRIVER=false

# === Legacy / Other Transports ===
# Port for Server-Sent Events (SSE)
SSE_PORT=3012
SSE_SESSION_TIMEOUT_MS=1800000

# === Logging ===
# Options: error, warn, info, debug
LOG_LEVEL=info

# === Advanced Database Options ===
# Page size for query results
PAGE_SIZE=100
# Query timeout (milliseconds)
QUERY_TIMEOUT=30000
# Maximum database connections
MAX_CONNECTIONS=50

# === Connection Pool ===
# Max persistent connections kept per server process (default: 5).
# When running many server processes against one server (e.g. one per database),
# lower this (1-2) to bound total idle connections.
FIREBIRD_POOL_MAX=5

# Idle time-to-live for pooled connections in milliseconds (default: 60000).
# Pooled connections idle longer than this are reaped and reopened on next use,
# protecting against silently-dropped sockets (NAT/firewall idle timeouts) on
# servers without their own idle timeout (Firebird 3.0). Set 0 to disable.
FIREBIRD_POOL_IDLE_MS=60000

# === Node Environment ===
NODE_ENV=development
